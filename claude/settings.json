{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(./**)",
      "WebSearch",
      "WebFetch",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(npm run lint *)",
      "Bash(npm run format *)",
      "Bash(npm run typecheck *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run gate-check *)",
      "Bash(node .ccsdd/gate-checker/dist/gate-check.mjs *)",
      "Bash(terraform init *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform plan *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push -vf*)",
      "Bash(git push * -vf*)",
      "Bash(git push -qf*)",
      "Bash(git push * -qf*)",
      "Bash(git push -uvf*)",
      "Bash(git push * -uvf*)",
      "Bash(git push -vuf*)",
      "Bash(git push * -vuf*)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform * apply *)",
      "Bash(terraform * destroy *)",
      "Bash(terraform * apply)",
      "Bash(terraform * destroy)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh secret delete *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api -XDELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api --method=DELETE *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * -XDELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api * --method=DELETE*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.npmrc)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Edit(.ccsdd/gate-checker/**)",
      "Edit(.ccsdd/templates/**)",
      "Edit(.ccsdd/docs/**)",
      "Edit(.ccsdd/scripts/**)",
      "Edit(.github/workflows/**)",
      "Edit(core.lock)"
    ]
  }
}
